# Private @max-network/* packages are published to the GitHub Packages npm registry. CI + local
# installs authenticate with a read:packages token exposed as NODE_AUTH_TOKEN (a repo secret in
# CI; an env var locally). npm substitutes the ${NODE_AUTH_TOKEN} placeholder at install time, so
# no token is ever committed.
@max-network:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
